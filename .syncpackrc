{
  "sortFirst": [
    "name",
    "version",
    "private",
    "license",
    "description",
    "repository",
    "packageManager",
    "type",
    "main",
    "scripts",
    "files",
    "exports",
    "publishConfig"
  ],
  "semverGroups": [
    {
      "range": "",
      "dependencies": [
        "@penumbra-zone/**",
        "@prax-wallet/**"
      ],
      "packages": [
        "**"
      ]
    },
    {
      "range": "^",
      "dependencies": [
        "@bufbuild/**",
        "@connectrpc/**"
      ],
      "packages": [
        "**"
      ]
    }
  ],
  "versionGroups": [
    {
      "label": "LOCAL integration/penumbrafi-57: @penumbrafi/{wasm,types,services} come from local file: tarballs",
      "dependencies": [
        "@penumbrafi/wasm",
        "@penumbrafi/types",
        "@penumbrafi/services",
        "@penumbra-zone/wasm",
        "@penumbra-zone/types",
        "@penumbra-zone/services"
      ],
      "isIgnored": true
    },
    {
      "label": "Pin @connectrpc for compatibility",
      "packages": [
        "**"
      ],
      "dependencies": [
        "@connectrpc/**"
      ],
      "pinVersion": "^1.6.1"
    },
    {
      "label": "Pin @bufbuild for compatibility",
      "packages": [
        "**"
      ],
      "dependencies": [
        "@bufbuild/**"
      ],
      "pinVersion": "^1.10.0"
    },
    {
      "label": "Use workspace protocol for local packages",
      "dependencies": [
        "$LOCAL"
      ],
      "pinVersion": "workspace:*"
    },
    {
      "label": "@types packages should only be under devDependencies",
      "dependencies": [
        "@types/**"
      ],
      "dependencyTypes": [
        "!dev"
      ],
      "isBanned": true
    },
    {
      "label": "Ban BSR packages",
      "dependencies": [
        "@buf/*"
      ],
      "isBanned": true
    }
  ]
}
