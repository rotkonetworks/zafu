{
  "name": "@zafu/interactions",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Wallet interactions for apps: one request in flight per intent, live status, honest outcomes, no timers that fire while the user is typing their password",
  "type": "module",
  "keywords": [
    "zafu",
    "wallet",
    "interactions",
    "connect",
    "approval",
    "dapp",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rotkonetworks/zafu.git",
    "directory": "packages/interactions"
  },
  "homepage": "https://github.com/rotkonetworks/zafu/tree/main/packages/interactions#readme",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --treeshake",
    "lint": "eslint \"**/*.ts*\"",
    "test": "vitest run"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "vitest": "~1.6.1"
  }
}
