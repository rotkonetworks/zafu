    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@noble/ciphers": "^2.3.0",
    "@noble/post-quantum": "^0.7.1",
    "@noble/hashes": "^1.8.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  }
}
