{
  "name": "@zafu/pq",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Hybrid post-quantum key agreement (X25519 + ML-KEM-768 / X-Wing) - harvest-now-decrypt-later-resistant confidentiality",
  "type": "module",
  "keywords": ["post-quantum", "ml-kem", "kyber", "x-wing", "xwing", "hybrid", "kem", "sealed-box", "zafu", "zcash"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rotkonetworks/zafu.git",
    "directory": "packages/pq"
  },
  "homepage": "https://github.com/rotkonetworks/zafu/tree/main/packages/pq#readme",
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --treeshake",
    "lint": "eslint \"**/*.ts*\"",
    "test": "vitest run"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
