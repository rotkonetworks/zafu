{
  "name": "@zafu/zirc",
  "version": "0.2.1",
  "license": "MIT",
  "description": "zirc - IRC-style channels on zid: a relay-blind encrypted room, genesis, a hash-chained log of modes and votes, an electorate you can audit, and hiding that is never deletion",
  "type": "module",
  "keywords": [
    "channels",
    "chat",
    "e2ee",
    "irc",
    "moderation",
    "relay",
    "votes",
    "zafu",
    "zid"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rotkonetworks/zafu.git",
    "directory": "packages/zirc"
  },
  "homepage": "https://github.com/rotkonetworks/zafu/tree/main/packages/zirc#readme",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/room/index.ts --format esm --dts --clean --treeshake",
    "lint": "eslint \"**/*.ts*\"",
    "test": "vitest run"
  },
  "exports": {
    ".": "./src/index.ts",
    "./room": "./src/room/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./room": {
        "types": "./dist/room/index.d.ts",
        "import": "./dist/room/index.js"
      }
    }
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@zafu/zid": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "vitest": "~1.6.1",
    "@noble/curves": "^1.9.7"
  }
}
