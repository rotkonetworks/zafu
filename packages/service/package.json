{
  "name": "@zafu/service",
  "version": "0.1.0",
  "license": "MIT",
  "description": "The services pattern, shared - Service/Filter composition (Eriksen, \"Your Server as a Function\") used by the zafu wallet runtime and the @zafu SDK packages",
  "type": "module",
  "keywords": [
    "service",
    "filter",
    "strategy",
    "finagle",
    "composition",
    "middleware",
    "zafu"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rotkonetworks/zafu.git",
    "directory": "packages/service"
  },
  "homepage": "https://github.com/rotkonetworks/zafu/tree/main/packages/service#readme",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --treeshake",
    "lint": "eslint \"**/*.ts*\"",
    "test": "vitest run"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "vitest": "~1.6.1"
  }
}
