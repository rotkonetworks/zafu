# Granter mnemonic lives in its own file (chmod 600), never in this env file.
FEEGRANT_MNEMONIC_FILE=/root/feegrant/granter.mnemonic
HOST=127.0.0.1
PORT=3335
# 1 only when the reverse proxy sets X-Forwarded-For
TRUST_PROXY=1
STATE_FILE=/root/feegrant/feegrant-state.json
# Limits (base units: INJ 18 decimals, USDC.inj 6). Defaults shown.
#SPEND_LIMIT=1000000000000000
#GRANT_TTL_HOURS=24
#MIN_USDC=1000000
#SPONSOR_BELOW_INJ=1000000000000000
#DAILY_GRANT_CAP=200
#PER_IP_DAILY_GRANT_CAP=3
#MIN_GRANTER_BALANCE=100000000000000000
# Base gas drip for the Peer buy (off unless BASE_KEY_FILE is set).
# Create the key on the host: ./feegrant init-base /root/feegrant/base.key
#BASE_KEY_FILE=/root/feegrant/base.key
#BASE_RPC=https://mainnet.base.org
#BASE_STATE_FILE=/root/feegrant/base-gas-state.json
#BASE_DRIP_WEI=20000000000000
#BASE_FUNDED_ABOVE_WEI=10000000000000
#BASE_MIN_SPONSOR_WEI=200000000000000
#BASE_DAILY_DRIP_CAP=200
#BASE_PER_IP_DAILY_DRIP_CAP=3
