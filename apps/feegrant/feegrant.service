[Unit]
Description=Injective gas sponsor (x/feegrant) for USDC.inj shield-ins
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/root/feegrant/feegrant.env
WorkingDirectory=/root/feegrant
ExecStart=/root/feegrant/feegrant
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/feegrant

[Install]
WantedBy=multi-user.target
