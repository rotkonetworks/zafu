{
  "manifest_version": 3,
  "name": "zafu wallet BETA",
  "short_name": "zafu BETA",
  "version": "29.0.0",
  "description": "shielded signing. Zcash + Penumbra privacy wallet with cold signing, FROST multisig, client-side proving, ed25519 app identity.",
  "key": "",
  "minimum_chrome_version": "119",
  "action": {},
  "omnibox": {
    "keyword": "zafu"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "favicon/beta/icon16.png",
    "32": "favicon/beta/icon32.png",
    "48": "favicon/beta/icon48.png",
    "128": "favicon/beta/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*", "http://[::1]/*"],
      "js": ["injected-session.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*", "http://[::1]/*"],
      "js": ["keplr-bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*", "http://[::1]/*"],
      "js": ["passkey-bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*", "http://[::1]/*"],
      "js": ["injected-penumbra-global.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*", "http://[::1]/*"],
      "js": ["injected-keplr.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*", "http://[::1]/*"],
      "js": ["passkey-intercept.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*", "http://[::1]/*"],
      "js": ["links.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "options_ui": {
    "page": "page.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["manifest.json", "favicon/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "permissions": [
    "storage",
    "unlimitedStorage",
    "offscreen",
    "alarms",
    "sidePanel",
    "contextMenus"
  ],
  "optional_permissions": ["webRequest", "scripting", "proxy"],
  "host_permissions": ["<all_urls>"],
  "externally_connectable": {
    "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*", "http://[::1]/*"]
  },
  "content_security_policy": {
    "extension_pages": "object-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:"
  },
  "cross_origin_opener_policy": {
    "value": "same-origin"
  },
  "cross_origin_embedder_policy": {
    "value": "require-corp"
  }
}
